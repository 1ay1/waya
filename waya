#!/bin/sh
# waya - the one command for a waya project.
#
# A tiny, dependency-free launcher (like `npm`/`cargo`) that wraps the whole
# workflow so you never have to remember the underlying cmake / script names.
#
#   waya new <name> [dir]     scaffold a fresh app (fetches waya via CMake)
#   waya dev [target]         watch + rebuild + live-reload in the browser
#   waya build [target]       configure (if needed) and build one target
#   waya run [target]         build then run the server (Ctrl-C to stop)
#   waya serve [target]       alias for `run`
#   waya list                 list the example targets you can dev/run
#   waya clean                remove the build directory
#   waya doctor               check your toolchain (cmake, compiler, watcher)
#   waya help                 this text
#
# Options common to dev/build/run:
#   -d, --build-dir <dir>     build directory        (default: build)
#   -p, --port <n>            server port             (sets WAYA_PORT)
#       --host <addr>         bind address            (sets WAYA_HOST)
#       --no-open             don't auto-open the browser
#   -j, --jobs <n>            parallel build jobs     (sets JOBS)
#
# Pure POSIX sh. Runs on Linux, macOS, the BSDs, and Windows under
# MSYS2 / Git-Bash / Cygwin / WSL. Native Windows cmd/PowerShell: use waya.cmd.
#
# ASCII only (a non-ASCII byte in a double-quoted string breaks `set -u` on
# some BSD shells).

set -u

# ── Locate the repo root (the dir holding this script) ───────────────────────
SELF="$0"
# Resolve symlinks so `waya` can be symlinked onto PATH and still find scripts/.
while [ -h "$SELF" ]; do
    _l="$(readlink "$SELF")"
    case "$_l" in /*) SELF="$_l" ;; *) SELF="$(dirname "$SELF")/$_l" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
SCRIPTS="$ROOT/scripts"

# ── Colours (TTY only) ───────────────────────────────────────────────────────
if [ -t 1 ]; then C='\033[36m'; B='\033[1m'; R='\033[31m'; Y='\033[33m'; G='\033[32m'; Z='\033[0m'
else C=''; B=''; R=''; Y=''; G=''; Z=''; fi
say()  { printf '%bwaya%b %b\n' "$C" "$Z" "$*"; }
die()  { printf '%bwaya%b %berror%b %b\n' "$C" "$Z" "$R" "$Z" "$*" >&2; exit 1; }
ok()   { printf '  %bok%b   %b\n' "$G" "$Z" "$*"; }
bad()  { printf '  %bmiss%b %b\n' "$R" "$Z" "$*"; }
note() { printf '  %b--%b   %b\n' "$Y" "$Z" "$*"; }

BUILD="build"

# ── Parse the shared options out of "$@", leaving positionals in REST ─────────
REST=""
parse_opts() {
    REST=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -d|--build-dir) BUILD="${2:?--build-dir needs a value}"; shift 2 ;;
            -p|--port)      WAYA_PORT="${2:?--port needs a value}"; export WAYA_PORT; shift 2 ;;
            --host)         WAYA_HOST="${2:?--host needs a value}"; export WAYA_HOST; shift 2 ;;
            --no-open)      WAYA_NO_OPEN=1; export WAYA_NO_OPEN; shift ;;
            -j|--jobs)      JOBS="${2:?--jobs needs a value}"; export JOBS; shift 2 ;;
            --)             shift; while [ $# -gt 0 ]; do REST="$REST $1"; shift; done ;;
            -*)             die "unknown option: $1  (try: waya help)" ;;
            *)              REST="$REST $1"; shift ;;
        esac
    done
    REST="${REST# }"
}

# ── The example targets, discovered from examples/*.cpp (single source of truth) ─
# Matches the CMake glob: every examples/<name>.cpp is a runnable target. No
# hand-maintained list, so a new example file just appears in `waya list`/`pick`.
examples() {
    for _f in "$ROOT"/examples/*.cpp; do
        [ -f "$_f" ] || continue                   # no matches -> skip the literal glob
        _n="${_f##*/}"; printf '%s\n' "${_n%.cpp}"
    done
}

# One-line blurb for an example, scraped from the first `///` (or `//`) comment
# in its source. Non-ASCII bytes (the em-dash separator maya uses) are dropped
# to a hyphen FIRST -- so this function, and this whole script, stays pure ASCII
# (a high byte in a quoted sed pattern breaks BSD sh under `set -u`). Then we
# strip the leading comment marker and the redundant "examples/NAME.cpp -"
# filename prefix, leaving just the human sentence.
describe() {
    _src="$ROOT/examples/$1.cpp"
    [ -f "$_src" ] || return 0
    sed -n '1,8p' "$_src" \
        | grep -m1 -E '^///?[[:space:]]' \
        | LC_ALL=C tr '\342\200\224' '-  ' | LC_ALL=C tr -d '\200-\377' \
        | sed -e 's|^///*[[:space:]]*||' \
              -e "s|^examples/$1\.cpp[[:space:]]*[-:]*[[:space:]]*||" \
              -e 's|^[[:space:]]*[-:][[:space:]]*||' \
        | cut -c1-58
}

# ── Interactive picker ───────────────────────────────────────────────────────
# An arrow-key menu of the example targets (with blurbs). Up/Down (or k/j) move
# the highlight, Enter selects, q or Esc quits; typing a digit jumps to that
# row. The chosen target name is echoed on stdout (the menu itself is drawn on
# stderr, so `$(pick_example)` captures only the name). Reads a TTY on stdin;
# callers gate on [ -t 0 ]. Falls back to a numbered prompt where `stty` or
# raw single-byte reads aren't available (e.g. some minimal shells).

# Read one keypress from the tty into KEY as a symbolic name: up/down/enter/
# quit/digit-N/other. Assumes the tty is already in raw (-icanon -echo) mode.
_read_key() {
    KEY=""
    _c="$(dd bs=1 count=1 2>/dev/null </dev/tty | od -An -tu1 | tr -d ' ')"
    [ -n "$_c" ] || { KEY=quit; return; }        # EOF -> treat as quit
    case "$_c" in
        10|13) KEY=enter ;;                        # LF / CR
        113|81) KEY=quit ;;                        # q / Q
        107) KEY=up ;;                             # k
        106) KEY=down ;;                           # j
        27)                                        # Esc: bare, or CSI arrow
            _b="$(dd bs=1 count=1 2>/dev/null </dev/tty | od -An -tu1 | tr -d ' ')"
            if [ "$_b" = 91 ] || [ "$_b" = 79 ]; then   # '[' or 'O'
                _d="$(dd bs=1 count=1 2>/dev/null </dev/tty | od -An -tu1 | tr -d ' ')"
                case "$_d" in 65) KEY=up ;; 66) KEY=down ;; *) KEY=other ;; esac
            else
                KEY=quit                           # lone Esc
            fi ;;
        4|3) KEY=quit ;;                           # Ctrl-D / Ctrl-C
        4[89]|5[0-7]) KEY="digit-$((_c - 48))" ;;  # '0'..'9'
        *) KEY=other ;;
    esac
}

# Draw the menu with row $_cur highlighted. First call just prints; later calls
# move the cursor back up over the previous render so it repaints in place.
_draw_menu() {
    [ "${_drawn:-0}" = 1 ] && printf '\033[%dA' "$_count" >&2   # cursor up N rows
    _n=0
    for _t in $_names; do
        _n=$((_n + 1))
        _d="$(describe "$_t")"
        printf '\033[2K' >&2                       # clear the whole line
        if [ "$_n" = "$_cur" ]; then
            printf '  %b> %-10s%b  %s\n' "$G$B" "$_t" "$Z" "$_d" >&2
        else
            printf '    %b%-10s%b  %s\n' "$B" "$_t" "$Z" "$_d" >&2
        fi
    done
    _drawn=1
}

# The plain fallback: numbered list + typed choice (the pre-arrow behaviour).
_pick_numbered() {
    _i=0
    for _t in $_names; do
        _i=$((_i + 1))
        printf '  %b%2d%b  %b%-10s%b  %s\n' "$G" "$_i" "$Z" "$B" "$_t" "$Z" "$(describe "$_t")" >&2
    done
    printf '\n%bwaya%b choose 1-%d or a name (Enter=1, q=quit): ' "$C" "$Z" "$_count" >&2
    IFS= read -r _sel </dev/tty || { printf '\n' >&2; return 1; }
    case "$_sel" in q|Q|quit|exit) return 1 ;; '') _sel=1 ;; esac
    case "$_sel" in
        *[!0-9]*) ;;                                # a name; validated below
        *) if [ "$_sel" -ge 1 ] 2>/dev/null && [ "$_sel" -le "$_count" ]; then
               _n=0; for _t in $_names; do _n=$((_n + 1)); [ "$_n" -eq "$_sel" ] && { printf '%s' "$_t"; return 0; }; done
           fi
           printf '%bwaya%b %berror%b no example #%s\n' "$C" "$Z" "$R" "$Z" "$_sel" >&2; return 1 ;;
    esac
    for _t in $_names; do [ "$_t" = "$_sel" ] && { printf '%s' "$_t"; return 0; }; done
    printf '%bwaya%b %berror%b unknown example: %s\n' "$C" "$Z" "$R" "$Z" "$_sel" >&2; return 1
}

pick_example() {
    _names=""; _count=0
    for _t in $(examples); do _names="$_names $_t"; _count=$((_count + 1)); done
    [ "$_count" -gt 0 ] || { printf '%bwaya%b %berror%b no examples found\n' "$C" "$Z" "$R" "$Z" >&2; return 1; }
    printf '%bwaya%b pick an example  %b(up/down, Enter, q)%b\n\n' "$C" "$Z" "$Y" "$Z" >&2

    # No raw-mode tty control? Degrade to the typed-number prompt.
    if ! command -v stty >/dev/null 2>&1 || ! command -v dd >/dev/null 2>&1; then
        _pick_numbered; return
    fi
    _saved="$(stty -g </dev/tty 2>/dev/null)" || { _pick_numbered; return; }
    # Restore the terminal + hide-cursor on any exit path (select, quit, Ctrl-C).
    trap 'stty "$_saved" </dev/tty 2>/dev/null; printf "\033[?25h" >&2' EXIT INT TERM
    stty -icanon -echo min 1 time 0 </dev/tty 2>/dev/null || { _pick_numbered; return; }
    printf '\033[?25l' >&2                          # hide cursor

    _cur=1; _drawn=0
    _draw_menu
    while :; do
        _read_key
        case "$KEY" in
            up)    [ "$_cur" -gt 1 ] && _cur=$((_cur - 1)) || _cur="$_count"; _draw_menu ;;
            down)  [ "$_cur" -lt "$_count" ] && _cur=$((_cur + 1)) || _cur=1; _draw_menu ;;
            digit-*) _j="${KEY#digit-}"
                     [ "$_j" -ge 1 ] && [ "$_j" -le "$_count" ] && { _cur="$_j"; _draw_menu; } ;;
            enter) break ;;
            quit)  stty "$_saved" </dev/tty 2>/dev/null; printf '\033[?25h' >&2; trap - EXIT INT TERM; return 1 ;;
            *) : ;;
        esac
    done

    stty "$_saved" </dev/tty 2>/dev/null; printf '\033[?25h' >&2; trap - EXIT INT TERM
    # Emit the highlighted target on stdout.
    _n=0
    for _t in $_names; do _n=$((_n + 1)); [ "$_n" -eq "$_cur" ] && { printf '%s' "$_t"; return 0; }; done
    return 1
}

# Resolve a target for run/dev/build: use the positional arg if given, else
# open the interactive picker on a TTY, else fall back to the default.
# Sets the global PICKED.
resolve_target() {
    _arg="${1:-}"
    if [ -n "$_arg" ]; then PICKED="$_arg"; return 0; fi
    if [ -t 0 ] && [ -t 2 ]; then
        PICKED="$(pick_example)" || exit 0
        [ -n "$PICKED" ] || exit 0
        return 0
    fi
    PICKED="counter"
}

# Resolve $BUILD to an absolute path: absolute inputs (e.g. -d /tmp/x) are used
# as-is; relative ones are anchored at the repo root, so `waya` works no matter
# what directory you invoke it from.
abs_build() {
    case "$BUILD" in
        /*|?:*) printf '%s' "$BUILD" ;;              # /abs on POSIX, C:\ on Windows
        *)      printf '%s' "$ROOT/$BUILD" ;;
    esac
}

need_cmake() {
    command -v cmake >/dev/null 2>&1 || die "cmake not found - install CMake >= 3.28 (try: waya doctor)."
}

# ── Subcommands ──────────────────────────────────────────────────────────────
cmd_new() {
    parse_opts "$@"
    set -- $REST
    [ $# -ge 1 ] || die "usage: waya new <name> [dir]"
    say "scaffolding ${B}$1${Z}..."
    sh "$SCRIPTS/create-waya-app.sh" "$@"
}

# Kill whatever is already listening on the port we're about to bind, so
# `waya run`/`waya dev` always just runs what you asked for instead of
# dying with "address already in use" because a previous run (or a stray
# systemd-managed instance) is still holding it.
kill_port() {
    _port="${WAYA_PORT:-8080}"
    case "$_port" in ''|*[!0-9]*) return 0 ;; esac
    if command -v fuser >/dev/null 2>&1; then
        fuser -k -TERM "${_port}/tcp" >/dev/null 2>&1 && sleep 1
        fuser -k -KILL "${_port}/tcp" >/dev/null 2>&1
    elif command -v ss >/dev/null 2>&1; then
        _pid="$(ss -tlnp 2>/dev/null | awk -v p=":$_port\$" '$4 ~ p {print $NF}' | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1)"
        [ -n "$_pid" ] && kill "$_pid" 2>/dev/null && sleep 1 && kill -9 "$_pid" 2>/dev/null
    fi
    return 0
}

cmd_dev() {
    parse_opts "$@"
    set -- $REST
    resolve_target "${1:-}"; target="$PICKED"
    need_cmake
    kill_port
    # dev.sh takes (target, build-dir) positionally; honours WAYA_PORT/HOST/JOBS.
    exec sh "$SCRIPTS/dev.sh" "$target" "$BUILD"
}

cmd_build() {
    parse_opts "$@"
    set -- $REST
    resolve_target "${1:-}"; target="$PICKED"
    need_cmake
    bdir="$(abs_build)"
    [ -f "$bdir/CMakeCache.txt" ] || {
        say "configuring ${B}$BUILD${Z}..."
        cmake -S "$ROOT" -B "$bdir" || die "configure failed."
    }
    say "building ${B}$target${Z}..."
    cmake --build "$bdir" --target "$target" ${JOBS:+-j "$JOBS"} \
        || die "build failed."
    ok "built -> $BUILD/$target"
}

find_binary() {
    _t="$1"; _bd="$(abs_build)"
    for cand in "$_bd/$_t" "$_bd/$_t.exe" \
                "$_bd"/*/"$_t" "$_bd"/*/"$_t.exe"; do
        [ -f "$cand" ] && [ -x "$cand" ] && { printf '%s' "$cand"; return 0; }
    done
    _b="$(find "$_bd" \( -name "$_t" -o -name "$_t.exe" \) -type f 2>/dev/null | head -1)"
    [ -n "$_b" ] && [ -x "$_b" ] && { printf '%s' "$_b"; return 0; }
    return 1
}

# Run one target's server in the background and return its PID in SRV_PID.
# Output streams straight to the terminal (so app logs still show).
_launch() {
    _t="$1"
    cmd_build "$_t" -d "$BUILD"
    _bin="$(find_binary "$_t")" || die "no binary produced for '$_t'."
    kill_port
    if [ -t 0 ] && [ -t 2 ]; then
        say "running ${B}$_t${Z}  ${Y}(press p to switch example, q to quit)${Z}"
    else
        say "running ${B}$_t${Z}  (Ctrl-C to stop)"
    fi
    # Detach the server's stdin from the terminal (</dev/null): otherwise the
    # server inherits the tty on fd 0 and races the supervisor for keystrokes,
    # swallowing the p / q control keys. The server doesn't read stdin anyway.
    "$_bin" </dev/null &
    SRV_PID=$!
}

# Stop the background server (TERM, then KILL) and wait for it to reap.
_stop_server() {
    [ -n "${SRV_PID:-}" ] || return 0
    kill -TERM "$SRV_PID" 2>/dev/null
    _w=0
    while kill -0 "$SRV_PID" 2>/dev/null && [ "$_w" -lt 20 ]; do
        sleep 0.1 2>/dev/null || sleep 1
        _w=$((_w + 1))
    done
    kill -KILL "$SRV_PID" 2>/dev/null
    wait "$SRV_PID" 2>/dev/null
    SRV_PID=""
}

cmd_run() {
    parse_opts "$@"
    set -- $REST
    resolve_target "${1:-}"; target="$PICKED"

    # Non-interactive (CI, pipes) or no single-byte tty control: the classic
    # behaviour -- build, exec the server, done. No hot-swap supervisor.
    if ! { [ -t 0 ] && [ -t 2 ]; } || ! command -v stty >/dev/null 2>&1 || ! command -v dd >/dev/null 2>&1; then
        cmd_build "$target" -d "$BUILD"
        bin="$(find_binary "$target")" || die "no binary produced for '$target'."
        kill_port
        say "running ${B}$target${Z}  (Ctrl-C to stop)"
        exec "$bin"
    fi

    # Interactive supervisor: run the server in the background and watch the
    # tty for 'p' (re-pick + hot-swap) or 'q'/Ctrl-C (quit). Server output still
    # streams to the terminal the whole time.
    SRV_PID=""
    _saved="$(stty -g </dev/tty 2>/dev/null)"
    _restore() { [ -n "$_saved" ] && stty "$_saved" </dev/tty 2>/dev/null; }
    trap '_restore; _stop_server; printf "\033[?25h" >&2; exit 0' INT TERM
    trap '_restore; _stop_server' EXIT

    _launch "$target"

    while :; do
        # If the server exited on its own (crash, or it's a one-shot), stop.
        if [ -n "$SRV_PID" ] && ! kill -0 "$SRV_PID" 2>/dev/null; then
            wait "$SRV_PID" 2>/dev/null; _rc=$?
            _restore; trap - EXIT INT TERM
            [ "$_rc" -eq 0 ] && exit 0
            die "$target exited (status $_rc)."
        fi
        # Poll the tty ~1s at a time for a control key, without blocking output.
        stty -icanon -echo min 0 time 10 </dev/tty 2>/dev/null || { wait "$SRV_PID" 2>/dev/null; break; }
        _k="$(dd bs=1 count=1 2>/dev/null </dev/tty | od -An -tu1 | tr -d ' ')"
        _restore
        case "$_k" in
            112|80)               # p / P -> switch example
                printf '\n' >&2
                _new="$(pick_example)" || { say "keeping ${B}$target${Z}."; continue; }
                [ -n "$_new" ] || { say "keeping ${B}$target${Z}."; continue; }
                _stop_server
                target="$_new"
                _launch "$target" ;;
            113|81|3|4)           # q / Q / Ctrl-C / Ctrl-D -> quit
                _stop_server; trap - EXIT INT TERM
                say "stopped."; exit 0 ;;
            *) : ;;               # timeout or other key -> keep serving
        esac
    done
}

cmd_list() {
    say "example targets (use with dev / run / build):"
    for t in $(examples); do
        d="$(describe "$t")"
        printf '  %b%-10s%b  %s\n' "$B" "$t" "$Z" "$d"
    done
}

# `waya pick` - open the menu, then run whatever is chosen (Ctrl-C to stop).
cmd_pick() {
    parse_opts "$@"
    [ -t 0 ] && [ -t 2 ] || die "pick needs an interactive terminal (try: waya list)."
    picked="$(pick_example)" || exit 0
    [ -n "$picked" ] || exit 0
    cmd_run "$picked" -d "$BUILD"
}

cmd_clean() {
    parse_opts "$@"
    bdir="$(abs_build)"
    if [ -d "$bdir" ]; then
        rm -rf "$bdir"
        say "removed ${B}$BUILD${Z}."
    else
        say "nothing to clean ($BUILD does not exist)."
    fi
}

cmd_doctor() {
    say "checking your toolchain..."
    if command -v cmake >/dev/null 2>&1; then
        ok "cmake     $(cmake --version 2>/dev/null | head -1 | awk '{print $3}')"
    else
        bad "cmake     not found - install CMake >= 3.28"
    fi

    cxx=""
    for c in "${CXX:-}" c++ g++ clang++; do
        [ -n "$c" ] && command -v "$c" >/dev/null 2>&1 && { cxx="$c"; break; }
    done
    if [ -n "$cxx" ]; then
        ok "compiler  $cxx ($("$cxx" --version 2>/dev/null | head -1))"
        note "waya needs C++26 (GCC 15+ / recent Clang)."
    else
        bad "compiler  no c++/g++/clang++ on PATH"
    fi

    if command -v fswatch >/dev/null 2>&1; then
        ok "watcher   fswatch (instant live-reload)"
    elif command -v inotifywait >/dev/null 2>&1; then
        ok "watcher   inotifywait (instant live-reload)"
    else
        note "watcher   none - dev uses mtime polling (works, ~1s latency)."
        note "          faster: 'brew install fswatch' or 'apt install inotify-tools'."
    fi

    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*) note "platform  Windows POSIX layer detected - the runtime works here." ;;
        *) : ;;
    esac
}

usage() {
    cat <<EOF
${B}waya${Z} - the one command for a waya project.

${B}Usage:${Z}  waya <command> [target] [options]

${B}Commands:${Z}
  new <name> [dir]   scaffold a fresh app (self-contained, fetches waya)
  dev [target]       watch, rebuild & live-reload   (default target: counter)
  build [target]     configure if needed, then build one target
  run [target]       build then run the server      (alias: serve)
                     while running: p = switch example, q = quit
  pick               interactively choose an example (arrow keys), then run
  list               list the example targets
  clean              remove the build directory
  doctor             check cmake / compiler / file watcher
  help               show this

${B}Options${Z} (for dev / build / run):
  -d, --build-dir <dir>   build directory     (default: build)
  -p, --port <n>          server port         (WAYA_PORT)
      --host <addr>       bind address        (WAYA_HOST)
      --no-open           don't open a browser
  -j, --jobs <n>          parallel build jobs (JOBS)

${B}Examples:${Z}
  waya new my-app && cd my-app && waya run
  waya pick                       # arrow-key menu, run your choice
  waya run                        # no target -> interactive picker
  waya dev palette
  waya run counter --port 9000 --no-open
  waya list
EOF
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
CMD="${1:-help}"
[ $# -gt 0 ] && shift

case "$CMD" in
    new|create)        cmd_new "$@" ;;
    dev|watch)         cmd_dev "$@" ;;
    build|b)           cmd_build "$@" ;;
    run|serve|start)   cmd_run "$@" ;;
    pick|choose|menu)  cmd_pick "$@" ;;
    list|ls|examples)  cmd_list ;;
    clean)             cmd_clean "$@" ;;
    doctor|check)      cmd_doctor ;;
    help|-h|--help|"") usage ;;
    *)                 printf '%bwaya%b %berror%b unknown command: %s\n\n' "$C" "$Z" "$R" "$Z" "$CMD" >&2; usage; exit 1 ;;
esac
