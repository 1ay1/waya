# Normalize line endings across platforms so a Windows checkout doesn't get
# CRLF in shell scripts (which breaks the #!/bin/sh shebang) or in headers.
* text=auto eol=lf

# Scripts are always LF (a CRLF here is a runtime crash under sh).
*.sh   text eol=lf

# PowerShell is happy with either; keep it CRLF-friendly on Windows.
*.ps1  text eol=crlf

# Source and docs: LF everywhere.
*.hpp  text eol=lf
*.cpp  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf

# Binary assets never get munged.
*.png  binary
*.woff2 binary
*.ico  binary
